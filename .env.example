AWS_REGION=ap-south-1
SCD_TABLE_NAME=

# Razorpay. Test keys locally, live keys only on the production app.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Set in the Razorpay dashboard when the webhook is created. Verifies every
# request to /api/webhook/razorpay. Never logged, never sent anywhere.
RAZORPAY_WEBHOOK_SECRET=
#
# !!! PLACEHOLDER PRICING, REMOVE BEFORE LAUNCH !!!
# Every tier in src/content/passes.ts still has pricePaise: null. Until each
# one has a real price, every order is created for this many paise. Default
# 100, one rupee. With live keys and this still in force, passes sell for Rs 1.
# Setting pricePaise on every tier makes this variable unreachable.
RAZORPAY_TEST_AMOUNT_PAISE=100

# Send only. There is no mailbox on awsscdhyd.in, so replies must go elsewhere.
SES_FROM="AWS SBG VJIT <vjit@awsscdhyd.in>"
SES_REPLY_TO=awssbgvjit@gmail.com
# console locally, ses in production. Set to ses locally only to test real sends.
EMAIL_TRANSPORT=console
# Read from amplify_outputs.json locally. Set explicitly where that file is absent.
SES_CONFIGURATION_SET=
# DNS records and the SES MAIL FROM domain are account-global, so exactly one
# deploy may own them. Set to true on the production Amplify app only. Never
# locally: a sandbox must not create or fight over public DNS.
SCD_MANAGE_DNS=
ADMIN_EMAILS=
CRON_SECRET=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
