AWS_REGION=ap-south-1
SCD_TABLE_NAME=
# Read from amplify_outputs.json locally. Set explicitly where that file is absent.
SCD_SCREENSHOT_BUCKET=

# How money moves: manual (UPI QR, UTR, admin verification, the default) or
# razorpay. Both end in the same VERIFIED state. See SPEC.md section 8.
PAYMENT_MODE=manual
# Development only, ignored in production: opens step one of registration
# for the acceptance suite without touching content/event.ts.
SCD_DEV_REGISTRATION_OPEN=

# Razorpay. Test keys locally, live keys only on the production app.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Set in the Razorpay dashboard when the webhook is created. Verifies every
# request to /api/webhook/razorpay. Never logged, never sent anywhere.
RAZORPAY_WEBHOOK_SECRET=
#
# Test amount for a tier with no price. Every tier is priced now, so this is
# unreachable, and in razorpay mode the launch guard refuses to sell while it
# is set at all. Leave it unset. See src/lib/tickets/launch.ts.
RAZORPAY_TEST_AMOUNT_PAISE=

# Send only. There is no mailbox on awsscdhyd.in, so replies must go elsewhere.
SES_FROM="AWS SBG VJIT <vjit@awsscdhyd.in>"
SES_REPLY_TO=awssbgvjit@gmail.com
# console locally, ses in production. Set to ses locally only to test real sends.
EMAIL_TRANSPORT=console
# Read from amplify_outputs.json locally. Set explicitly where that file is absent.
SES_CONFIGURATION_SET=
# DNS records and the SES MAIL FROM domain are account-global, so exactly one
# deploy may own them. Set to true on the production Amplify app only. Never
# locally: a sandbox must not create or fight over public DNS.
SCD_MANAGE_DNS=
# Fallback only: roles live in the table and this grants nothing while the table holds one admin.
ADMIN_EMAILS=
CRON_SECRET=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
