    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@aws-amplify/backend": "1.24.1",
    "@aws-amplify/backend-cli": "1.9.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "aws-cdk-lib": "2.268.0",
    "constructs": "10.8.1",
    "eslint": "^9",
